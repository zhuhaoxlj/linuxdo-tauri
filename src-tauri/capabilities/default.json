{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "clipboard-manager:allow-read-image",
    "deep-link:default",
    "opener:default",
    "allow-start-oauth-flow",
    "allow-cancel-login",
    "allow-handle-auth-callback",
    "allow-restore-session",
    "allow-logout",
    "allow-discourse-request",
    "allow-fetch-forum-image",
    "allow-upload-file"
  ]
}
